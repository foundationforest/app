{
  "name": "@forest/app",
  "version": "0.0.0",
  "private": true,
  "description": "The Forest app: the person's control panel. The seed and keys live only on the device; a web app first, phones later from the same code. Devnet only.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node --test --test-force-exit --test-concurrency=1 test/browser/run.ts test/browser/app.ts"
  },
  "dependencies": {
    "@cloudflare/privacypass-ts": "0.9.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@scure/base": "2.4.0",
    "@solana/web3.js": "1.99.0",
    "buffer": "6.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.4"
  }
}
