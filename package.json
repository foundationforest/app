{
  "name": "@forest/app",
  "version": "0.0.0",
  "private": true,
  "description": "The Forest app: the person's control panel for Forest. It makes their profiles and gets them verified: the seed is their passkey's secret, never stored on a device. A web app, from the standard, the markets and services' credits client at their pins.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && tsc --noEmit -p test/browser",
    "test": "vitest run",
    "test:browser": "tsc --noEmit -p test/browser && node --disable-warning=ExperimentalWarning --test --test-force-exit --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/browser/no-skips.ts --test-reporter-destination=stderr test/browser/run.ts"
  },
  "dependencies": {
    "@cloudflare/privacypass-ts": "0.9.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@scure/base": "2.4.0",
    "maplibre-gl": "6.16.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.4"
  }
}
