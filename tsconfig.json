{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2024",
      "dom",
      "dom.iterable"
    ],
    "types": [
      "vite/client",
      "node"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@foundationforest/keys": [
        "./standard/keys/dist/index.d.ts"
      ],
      "@foundationforest/folders": [
        "./standard/folders/dist/index.d.ts"
      ],
      "@foundationforest/folders/locked": [
        "./standard/folders/dist/locked.d.ts"
      ],
      "@foundationforest/proofs": [
        "./standard/proofs/dist/index.d.ts"
      ],
      "@foundationforest/markets/browser": [
        "./markets/build/dist/browser.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "build",
    "vite.config.ts"
  ],
  "exclude": [
    "test/browser"
  ]
}
